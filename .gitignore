# ==========================================
# OrbitGuard AI — Git Ignore
# ==========================================

# ---- Python cache files ----
__pycache__/
*.py[cod]
*$py.class

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Node & Frontend artifacts ----
node_modules/
dist/
build/
*.egg-info/
.eggs/

# ---- Local environment variables and secrets ----
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# ---- IDE and editor files ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Operating system files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Local caches ----
.cache/
**/.cache/
celestrak_cache/
cache/

# ---- Raw datasets: keep large CSV files out of Git ----
Dataset/*.csv
Dataset/**/*.csv
data/raw/
data/processed/

# ---- Generated dataset exports ----
exports/trained_dataset.json
exports/test_predictions.json

# ---- Temporary notebook files ----
.ipynb_checkpoints/
*.ipynb_checkpoints/

# ---- Logs and temporary files ----
*.log
logs/
tmp/
temp/

# ---- Test and coverage artifacts ----
.pytest_cache/
.coverage
htmlcov/

# ---- Model training checkpoints and temporary artifacts ----
*.tmp
*.bak
*.checkpoint

# ---- Local database files ----
*.sqlite
*.sqlite3
*.db
